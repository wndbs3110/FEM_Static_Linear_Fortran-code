clear all; clc; close all;
% =========================================================================
% 파일 열기 및 헤더 읽기
% =========================================================================
fid = fopen('SATURN_pos.txt','r');
if fid == -1
    error('SATURN_pos.txt 파일을 찾을 수 없습니다.');
end
n           = fscanf(fid, '%i', 1);   % 요소 개수
scalefactor = fscanf(fid, '%g', 1);   % 스케일 팩터

% =========================================================================
% Figure 설정
% =========================================================================
fig_names = {'Von Mises Stress', ...
             'Normal Stress SXX', ...
             'Normal Stress SYY', ...
             'Shear Stress SXY', ...
             'Deflection W', ...
             'Total Displacement |W|'};
nFig = numel(fig_names);
hFig = gobjects(nFig, 1);
hAx  = gobjects(nFig, 1);
hCb  = gobjects(nFig, 1);

for f = 1:nFig
    hFig(f) = figure(f);
    set(hFig(f), 'Name', fig_names{f});
    hAx(f)  = gca;
    set(hAx(f), 'DataAspectRatio', [1 1 1]);
    hCb(f)  = colorbar;
    colormap(hFig(f), jet(100));
    xlabel('X'); ylabel('Y');
    hold(hAx(f), 'on');
end

% =========================================================================
% 배열 할당
% =========================================================================
nNodes  = 4 * n;
svm_all = zeros(nNodes, 1);
sxx_all = zeros(nNodes, 1);
syy_all = zeros(nNodes, 1);
sxy_all = zeros(nNodes, 1);
Xall    = zeros(nNodes, 1);
Yall    = zeros(nNodes, 1);

% 변위 데이터 (u, v도 추가 저장)
Uall    = zeros(nNodes, 1);
Vall    = zeros(nNodes, 1);
Wall    = zeros(nNodes, 1);
Dispall = zeros(nNodes, 1);

% =========================================================================
% 요소 루프 (노드당 11개 데이터: X, Y, u, v, w, tx, ty, txy, Sxx, Syy, Sxy)
% =========================================================================
for j = 1:n
    for i = 1:4
        idx = i + 4*(j-1);
        
        % 1) 좌표 (2개)
        Xall(idx) = fscanf(fid, '%g', 1);
        Yall(idx) = fscanf(fid, '%g', 1);
        
        % 2) DOF 6개: u, v, w, tx, ty, txy
        dofs      = fscanf(fid, '%g', 6);
        
        Uall(idx)    = dofs(1);          % u
        Vall(idx)    = dofs(2);          % v
        Wall(idx)    = dofs(3);          % w (세 번째 값이 실제 처짐!)
        Dispall(idx) = sqrt(wall(idx).^2 );
        
        % 3) 응력 3개: Sxx, Syy, Sxy
        sxx_val      = fscanf(fid, '%g', 1);
        syy_val      = fscanf(fid, '%g', 1);
        sxy_val      = fscanf(fid, '%g', 1);
        
        sxx_all(idx) = sxx_val;
        syy_all(idx) = syy_val;
        sxy_all(idx) = sxy_val;
        
        % 4) Von Mises 응력
        svm_all(idx) = sqrt(sxx_val^2 - sxx_val*syy_val + syy_val^2 + 3*sxy_val^2);
    end
end
fclose(fid);

% =========================================================================
% 통계 계산 및 결과 출력
% =========================================================================
allData   = {svm_all, sxx_all, syy_all, sxy_all, Wall, Dispall};
allLabels = {'Von Mises', 'SXX', 'SYY', 'SXY', 'Deflection W', '|W|'};

fprintf('==========================================================\n');
fprintf('  Post-Processing Results  (n_elem=%d, scale=%.4g)\n', n, scalefactor);
fprintf('==========================================================\n\n');

for k = 1:numel(allData)
    d = allData{k};
    fprintf(' %s:\n', allLabels{k});
    fprintf('   Max : %+.6e\n   Min : %+.6e\n   Avg : %+.6e\n\n', ...
            max(d), min(d), mean(d));
end
fprintf(' (Info) Total nodes (with dup) : %d\n', nNodes);
fprintf('==========================================================\n');

% =========================================================================
% Patch 기반의 요소 렌더링
% =========================================================================
X_patch = reshape(Xall, 4, n);
Y_patch = reshape(Yall, 4, n);

for f = 1:nFig
    figure(f);
    
    C_patch = reshape(allData{f}, 4, n);
    
    patch(hAx(f), 'XData', X_patch, 'YData', Y_patch, 'CData', C_patch, ...
          'FaceColor', 'interp', 'EdgeColor', 'none');
    
    axis(hAx(f), 'equal'); 
    axis(hAx(f), 'tight');
    
    dmin = min(allData{f}); 
    dmax = max(allData{f});
    if dmax == dmin
        dmax = dmin + eps; 
    end
    clim(hAx(f), [dmin, dmax]);
    hCb(f).Ticks = linspace(dmin, dmax, 10);
    hCb(f).FontSize = 11;
    
    title(hAx(f), fig_names{f});
end